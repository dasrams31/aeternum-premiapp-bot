# 2. Database Configuration (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:secretpassword@localhost:5432/aeternum_premiapp_db

# 3. Payment Gateway (QRIS)
# Pilihan: tripay / pakasir / manual
PAYMENT_GATEWAY=tripay
GATEWAY_API_KEY=DEV-YOUR-TRIPAY-API-KEY
GATEWAY_PRIVATE_KEY=YOUR-TRIPAY-PRIVATE-KEY
